{
  "manifestVersion": 2,
  "id": "issue-tracker",
  "name": "Issues",
  "version": "0.1.0",
  "description": "Linear처럼 프로젝트를 만들고 이슈를 관리하는 사이드바 패널.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "agent:read"
    }
  ],
  "contributes": {
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "customEditors": [
      {
        "id": "issue-result",
        "title": "에이전트 결과",
        "extensions": [
          ".issue-result"
        ],
        "entry": "src/result-editor.ts",
        "frame": "isolated"
      },
      {
        "id": "issue-manual",
        "title": "Issues 매뉴얼",
        "extensions": [
          ".issue-manual"
        ],
        "entry": "docs/manual.html",
        "frame": "isolated"
      }
    ],
    "panels": [
      {
        "id": "issues",
        "title": "Issues",
        "icon": "flag",
        "entry": "src/panel.html"
      }
    ]
  }
}
